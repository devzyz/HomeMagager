# 复制为 .env 使用。开发模式（NODE_ENV=development）下 SESSION_SECRET 未配置时会自动生成临时密钥。
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# 仓库根目录 .env 会自动加载；系统环境变量优先。当前保持本地模式即可。
# 可信访问入口：开发可留空；以后接入隧道时填写 https://你的域名（不带路径）
BASE_URL=
# 同机 cloudflared 接入后可设 loopback；不支持不加限制地信任全部代理
TRUST_PROXY=false

TZ=Asia/Shanghai
SESSION_SECRET=
SESSION_MAX_AGE_DAYS=7

# 默认位于仓库根目录 data/ 下，可按需覆盖
# 生产环境可指向源码目录外的私密数据目录，参见 docs/private-data-layout.md。
# DATABASE_PATH=/app/data/database/family-expense.db
# UPLOAD_DIR=/app/data/uploads
# BACKUP_DIR=/app/data/backups

BACKUP_INTERVAL_DAYS=7
LOCAL_BACKUP_KEEP=2

# 阿里云盘上传适配器尚未实现，保持 false；Google Drive 见下方配置。
ALIYUN_DRIVE_ENABLED=false
# 下列为后续上传适配器预留，目前不读取；不要在前端或版本库保存凭据
# ALIYUN_DRIVE_CLIENT_ID=
# ALIYUN_DRIVE_CLIENT_SECRET=
# ALIYUN_DRIVE_TOKEN_FILE=/app/data/secrets/aliyundrive.json
# ALIYUN_DRIVE_REMOTE_PATH=/homeManager/

# Google Drive：先完成首次 OAuth 授权并安全保存 rclone 配置，再启用。
# 云端每周日北京时间 03:00，保留最近 5 组完整备份；独立于本地保留数量。
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_CONFIG=
GOOGLE_DRIVE_REMOTE=homemanager
GOOGLE_DRIVE_KEEP=5
RCLONE_BIN=rclone
